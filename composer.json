{
    "name": "douglasgreen/dbtools",
    "description": "MySQL database tools written in PHP",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Douglas S. Green"
        }
    ],
    "require": {
        "php": "^8.3",
        "ext-pdo": "*",
        "ext-pdo_mysql": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "DouglasGreen\\DbTools\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "DouglasGreen\\DbTools\\Tests\\": "tests/"
        }
    },
    "bin": [
        "bin/dbsync.php"
    ],
    "config": {
        "sort-packages": true
    },
    "scripts": {
        "test": "phpunit"
    }
}
